{
  "expo": {
    "name": "VJR 221",
    "slug": "vjr221-mobile",
    "scheme": "vjr221",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.vjr221.mobile",
      "buildNumber": "3",
      "associatedDomains": ["applinks:vjr221.sn"]
    },
    "android": {
      "package": "sn.vjr221.mobile",
      "versionCode": 3,
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "vjr221.sn" },
            { "scheme": "https", "host": "www.vjr221.sn" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4E9D6",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#11170F" }
        }
      ]
    ]
  }
}
