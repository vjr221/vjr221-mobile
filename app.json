{
  "expo": {
    "name": "VJR 221",
    "slug": "vjr221-mobile",
    "scheme": "vjr221",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.vjr221.mobile",
      "buildNumber": "17",
      "associatedDomains": [
        "applinks:vjr221.sn"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "VJR 221 utilise votre position uniquement lorsque vous activez « Près de moi », pour classer les fiches de l’annuaire par proximité."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "sn.vjr221.mobile",
      "versionCode": 17,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F4E9D6"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/regions" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/departements" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/communes" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/quartiers-villages" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/annuaire" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/directory" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/tourisme" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/patrimoine" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/gastronomie" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/personnalites" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/histoire" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/nature" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/culture" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/evenements" },
            { "scheme": "https", "host": "vjr221.sn", "pathPrefix": "/actualites" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/regions" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/departements" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/communes" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/quartiers-villages" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/annuaire" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/directory" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/tourisme" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/patrimoine" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/gastronomie" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/personnalites" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/histoire" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/nature" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/culture" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/evenements" },
            { "scheme": "https", "host": "www.vjr221.sn", "pathPrefix": "/actualites" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4E9D6",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#11170F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VJR 221 utilise votre position uniquement lorsque vous activez « Près de moi », pour classer les fiches de l’annuaire par proximité.",
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
